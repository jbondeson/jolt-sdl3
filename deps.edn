{;; jolt.ffi/write takes the value before the offset from 0.8.0 on, and :bool
 ;; returns, [:by-value ...] aggregates and [:union ...] layouts all need a
 ;; runtime of that generation, so refuse older ones rather than misbehave.
 :jolt/min-version "0.8.0"

 :paths ["src"]

 ;; libSDL3 is loaded by jolt before any sdl3.* namespace is required, so the
 ;; bindings resolve. Names are searched on the loader path; the absolute paths
 ;; cover Homebrew prefixes that are not on it.
 :jolt/native [{:name "SDL3"
                :darwin ["libSDL3.0.dylib" "libSDL3.dylib"
                         "/opt/homebrew/lib/libSDL3.0.dylib"
                         "/usr/local/lib/libSDL3.0.dylib"]
                :linux ["libSDL3.so.0" "libSDL3.so"]
                :windows ["SDL3.dll"]}
               ;; the satellite libraries are optional: a project that never requires
               ;; sdl3.ttf or sdl3.image does not need them installed
               {:name "SDL3_ttf"
                :darwin ["libSDL3_ttf.0.dylib" "libSDL3_ttf.dylib"
                         "/opt/homebrew/lib/libSDL3_ttf.0.dylib"
                         "/usr/local/lib/libSDL3_ttf.0.dylib"]
                :linux ["libSDL3_ttf.so.0" "libSDL3_ttf.so"]
                :windows ["SDL3_ttf.dll"]
                :optional true}
               {:name "SDL3_image"
                :darwin ["libSDL3_image.0.dylib" "libSDL3_image.dylib"
                         "/opt/homebrew/lib/libSDL3_image.0.dylib"
                         "/usr/local/lib/libSDL3_image.0.dylib"]
                :linux ["libSDL3_image.so.0" "libSDL3_image.so"]
                :windows ["SDL3_image.dll"]
                :optional true}]

 :aliases {:test {:extra-paths ["test" "examples"]
                  :main-opts ["-m" "sdl3.test-runner"]}
           :examples {:extra-paths ["examples"]}}

 :tasks {gen    "jolt tools/gen.clj"
         test   "jolt -M:test"
         showcase {:doc "run a showcase example: jolt showcase bounce (no name lists them)"
                   :task (apply shell "jolt" "-M:examples" "-m" "examples.showcase.run" *command-line-args*)}
         sdl-example {:doc "run an SDL example port: jolt sdl-example renderer/clear (no name lists them)"
                      :task (apply shell "jolt" "-M:examples" "-m" "examples.sdl.run" *command-line-args*)}}}
